@page "/not-found"

<PageTitle>Nao encontrado</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="not-found">
    <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" Color="Color.Primary" />
    <MudText Typo="Typo.h4">Pagina nao encontrada</MudText>
    <MudText Typo="Typo.body1" Class="muted">O endereco solicitado nao existe nesta aplicacao.</MudText>
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Home">Voltar</MudButton>
</MudContainer>

