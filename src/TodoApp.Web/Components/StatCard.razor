<MudPaper Class="stat-card" Elevation="0">
    <span class="stat-card__icon">
        <MudIcon Icon="@Icon" Color="@Color" Size="Size.Medium" />
    </span>
    <div>
        <MudText Typo="Typo.caption" Class="stat-label">@Label</MudText>
        <MudText Typo="Typo.h5">@Value</MudText>
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Icon { get; set; } = Icons.Material.Filled.CheckCircle;

    [Parameter]
    public Color Color { get; set; } = Color.Primary;
}
